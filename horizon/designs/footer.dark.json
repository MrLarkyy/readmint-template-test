{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "Footer",
  "description": "A closing headline, how to get in touch, a note and the date of this render.",
  "canvas": {
    "width": 840,
    "height": 210
  },
  "assets": {
    "fonts": {
      "xb": {
        "family": "Archivo ExtraCondensed",
        "src": "fonts/ArchivoExtraCondensed-ExtraBold.ttf",
        "weight": 800,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "scm": {
        "family": "Archivo SemiCondensed",
        "src": "fonts/ArchivoSemiCondensed-Medium.ttf",
        "weight": 500,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "reg": {
        "family": "Archivo",
        "src": "fonts/Archivo-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "mono": {
        "family": "Geist Mono",
        "src": "fonts/GeistMono-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "components": {
    "card": {
      "props": {
        "theme": {
          "type": "enum",
          "values": ["light", "dark"],
          "default": "light"
        },
        "headline": {
          "type": "string",
          "default": ""
        },
        "note": {
          "type": "string",
          "default": ""
        },
        "contactLabel": {
          "type": "string",
          "default": ""
        },
        "contactText": {
          "type": "string",
          "default": ""
        }
      },
      "layers": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": 840,
          "height": 1,
          "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}"
        },
        {
          "type": "group",
          "x": 0,
          "y": 12,
          "width": 560,
          "height": 160,
          "clip": true,
          "if": "{{ props.headline }}",
          "children": [
            {
              "type": "group",
              "x": 0,
              "y": -12,
              "children": [
                {
                  "type": "text",
                  "x": -2,
                  "y": 28.288,
                  "content": "{{ props.headline | upper }}",
                  "font": "xb",
                  "fontSize": 68,
                  "lineHeight": 0.9706,
                  "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "x": 580,
          "width": 260,
          "align": "end",
          "y": 53.495,
          "content": "{{ props.contactLabel || \"github\" | lower | truncate(30) }}",
          "font": "mono",
          "fontSize": 11,
          "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
        },
        {
          "type": "text",
          "x": "{{ 824 - ((props.contactText || \"github.com/\" + github.login) | truncate(32) | truncateWidth(260, \"scm\", 18) | textWidth(\"scm\", 18)) }}",
          "y": 75.188,
          "content": "{{ (props.contactText || \"github.com/\" + github.login) | truncate(32) | truncateWidth(260, \"scm\", 18) }}",
          "font": "scm",
          "fontSize": 18,
          "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}"
        },
        {
          "type": "path",
          "d": "M829 90 L837 82 M831 82 H837 V88",
          "fill": "none",
          "stroke": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}",
          "strokeWidth": 1.5
        },
        {
          "type": "rect",
          "x": "{{ 840 - (((props.contactText || \"github.com/\" + github.login) | truncate(32) | truncateWidth(260, \"scm\", 18) | textWidth(\"scm\", 18)) + 16) }}",
          "y": 99,
          "width": "{{ ((props.contactText || \"github.com/\" + github.login) | truncate(32) | truncateWidth(260, \"scm\", 18) | textWidth(\"scm\", 18)) + 16 }}",
          "height": 3,
          "fill": "{{ props.theme == \"dark\" ? \"#FF8A3D\" : \"#E8590C\" }}"
        },
        {
          "type": "group",
          "x": 560,
          "y": 112,
          "width": 280,
          "height": 44,
          "clip": true,
          "if": "{{ props.note }}",
          "children": [
            {
              "type": "group",
              "x": -560,
              "y": -112,
              "children": [
                {
                  "type": "text",
                  "x": 560,
                  "width": 280,
                  "align": "end",
                  "y": 113.324,
                  "content": "{{ props.note }}",
                  "font": "reg",
                  "fontSize": 14,
                  "lineHeight": 1.4286,
                  "fill": "{{ props.theme == \"dark\" ? \"#CFCBC4\" : \"#3A3A3A\" }}"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "x": 0,
          "y": 187.972,
          "content": "{{ \"rendered by readmint · \" + (github.contributions.to | date(\"d MMM yyyy\") | lower) }}",
          "font": "mono",
          "fontSize": 10.5,
          "fill": "{{ props.theme == \"dark\" ? \"#8A8680\" : \"#757575\" }}"
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "dark"
      }
    }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "Selected work",
  "description": "The heading of the repositories below, ranked by their stars.",
  "canvas": {
    "width": 840,
    "height": 40
  },
  "assets": {
    "fonts": {
      "xbold": {
        "family": "Archivo ExtraCondensed",
        "src": "fonts/ArchivoExtraCondensed-Bold.ttf",
        "weight": 700,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "mono": {
        "family": "Geist Mono",
        "src": "fonts/GeistMono-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "components": {
    "card": {
      "props": {
        "theme": {
          "type": "enum",
          "values": ["light", "dark"],
          "default": "light"
        }
      },
      "layers": [
        {
          "type": "text",
          "x": 0,
          "y": 7.99,
          "content": "SELECTED WORK",
          "font": "xbold",
          "fontSize": 15,
          "letterSpacing": 0.9,
          "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}"
        },
        {
          "type": "text",
          "x": 0,
          "width": 840,
          "align": "end",
          "y": 11.495,
          "content": "sort: stars desc",
          "font": "mono",
          "fontSize": 11,
          "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
        },
        {
          "type": "rect",
          "x": 0,
          "y": 34,
          "width": 840,
          "height": 1,
          "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}"
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "light"
      }
    }
  ]
}

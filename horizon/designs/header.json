                    {
                      "offset": 0.533333,
                      "value": 0.7
                    },
                    {
                      "offset": 0.6,
                      "value": 0
                    },
                    {
                      "offset": 0.6,
                      "value": 0.7
                    },
                    {
                      "offset": 0.666667,
                      "value": 0
                    },
                    {
                      "offset": 0.666667,
                      "value": 0.7
                    },
                    {
                      "offset": 0.733333,
                      "value": 0

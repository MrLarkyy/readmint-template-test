                    },
                    {
                      "offset": 1,
                      "value": 0
                    }
                  ],
                  "duration": 30000,
                  "stagger": 30000
                },
                "scale": {
                  "keyframes": [
                    {
                      "offset": 0,
                      "value": 1
                    },
                    {
                      "offset": 0,
                      "value": 1
                    },
                    {
                      "offset": 0.066667,
                      "value": 2.5
                    },
                    {
                      "offset": 0.066667,
                      "value": 1
                    },
                    {
                      "offset": 0.133333,
                      "value": 2.5
                    },
                    {
                      "offset": 0.133333,

{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "Profile header",
  "description": "The name as a full-width poster line, then what the person does, what they work on and their status.",
  "canvas": {
    "width": 840,
    "height": 262
  },
  "assets": {
    "fonts": {
      "xb": {
        "family": "Archivo ExtraCondensed",
        "src": "fonts/ArchivoExtraCondensed-ExtraBold.ttf",
        "weight": 800,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "scm": {
        "family": "Archivo SemiCondensed",
        "src": "fonts/ArchivoSemiCondensed-Medium.ttf",
        "weight": 500,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "sc": {
        "family": "Archivo SemiCondensed",
        "src": "fonts/ArchivoSemiCondensed-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "mono": {
        "family": "Geist Mono",
        "src": "fonts/GeistMono-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "animation": {
    "duration": 60000,
    "loop": true
  },
  "components": {
    "card": {
      "props": {
        "theme": {
          "type": "enum",
          "values": [
            "light",
            "dark"
          ],
          "default": "light"
        },
        "role": {
          "type": "string",
          "default": ""
        },
        "roleDetail": {
          "type": "string",
          "default": ""
        },
        "workingOn": {
          "type": "string",
          "default": ""
        },
        "workingOnDetail": {
          "type": "string",
          "default": ""
        },
        "statusNote": {
          "type": "string",
          "default": ""
        }
      },
      "layers": [
        {
          "type": "text",
          "x": 0,
          "y": 7.495,
          "content": "{{ \"~/\" + (github.login | truncate(40)) + \"/README.md\" }}",
          "font": "mono",
          "fontSize": 11,
          "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
        },
        {
          "type": "text",
          "x": 420,
          "width": 420,
          "align": "end",
          "y": 7.495,
          "content": "{{ (github.location ? (github.location | lower | truncate(30)) + \" · \" : \"\") + (github.contributions.to | date(\"d MMM yyyy\") | lower) }}",
          "font": "mono",
          "fontSize": 11,
          "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
        },
        {
          "type": "group",
          "repeat": {
            "each": "{{ [(github.name || github.login) | upper | truncate(40)] }}",
            "as": "nm"
          },
          "children": [
            {
              "type": "group",
              "repeat": {
                "each": "{{ [840 / ((nm | length) * 0.452 | max(1)) | min(124) | round(1)] }}",
                "as": "fs"
              },
              "children": [
                {
                  "type": "group",
                  "x": 0,
                  "y": 20,
                  "width": 840,
                  "height": 150,
                  "clip": true,
                  "children": [
                    {
                      "type": "group",
                      "x": 0,
                      "y": -20,
                      "children": [
                        {
                          "type": "text",
                          "x": 0,
                          "y": "{{ 142 - fs * 0.934 }}",
                          "content": "{{ nm }}",
                          "font": "xb",
                          "fontSize": "{{ fs }}",
                          "letterSpacing": "{{ 0 - fs * 0.01 }}",
                          "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "rect",
          "x": 0,
          "y": 170,
          "width": 840,
          "height": 1,
          "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}"
        },
        {
          "type": "group",
          "if": "{{ props.role || props.roleDetail }}",
          "children": [
            {
              "type": "text",
              "x": 0,
              "y": 185.495,
              "content": "role",
              "font": "mono",
              "fontSize": 11,
              "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
            },
            {
              "type": "group",
              "x": 0,
              "y": 200,
              "width": 270,
              "height": 26,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": 0,
                  "y": -200,
                  "children": [
                    {
                      "type": "text",
                      "x": 0,
                      "y": 204.122,
                      "content": "{{ props.role }}",
                      "font": "scm",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}",
                      "if": "{{ props.role }}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "group",
              "x": 0,
              "y": 226,
              "width": 270,
              "height": 24,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": 0,
                  "y": -226,
                  "children": [
                    {
                      "type": "text",
                      "x": 0,
                      "y": 227.122,
                      "content": "{{ props.roleDetail }}",
                      "font": "sc",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#CFCBC4\" : \"#3A3A3A\" }}",
                      "if": "{{ props.roleDetail }}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "if": "{{ props.workingOn || props.workingOnDetail }}",
          "children": [
            {
              "type": "text",
              "x": 290,
              "y": 185.495,
              "content": "working_on",
              "font": "mono",
              "fontSize": 11,
              "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
            },
            {
              "type": "group",
              "x": 290,
              "y": 200,
              "width": 270,
              "height": 26,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": -290,
                  "y": -200,
                  "children": [
                    {
                      "type": "text",
                      "x": 290,
                      "y": 204.122,
                      "content": "{{ props.workingOn }}",
                      "font": "scm",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}",
                      "if": "{{ props.workingOn }}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "group",
              "x": 290,
              "y": 226,
              "width": 270,
              "height": 24,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": -290,
                  "y": -226,
                  "children": [
                    {
                      "type": "text",
                      "x": 290,
                      "y": 227.122,
                      "content": "{{ props.workingOnDetail }}",
                      "font": "sc",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#CFCBC4\" : \"#3A3A3A\" }}",
                      "if": "{{ props.workingOnDetail }}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "if": "{{ github.status.message || props.statusNote }}",
          "children": [
            {
              "type": "text",
              "x": 580,
              "y": 185.495,
              "content": "status",
              "font": "mono",
              "fontSize": 11,
              "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
            },
            {
              "type": "ellipse",
              "x": 580.5,
              "y": 211.5,
              "width": 7,
              "height": 7,
              "fill": "{{ props.theme == \"dark\" ? \"#FF8A3D\" : \"#E8590C\" }}"
            },
            {
              "type": "ellipse",
              "x": 580.5,
              "y": 211.5,
              "width": 7,
              "height": 7,
              "fill": "none",
              "stroke": "{{ props.theme == \"dark\" ? \"#FF8A3D\" : \"#E8590C\" }}",
              "strokeWidth": 0.6,
              "repeat": {
                "each": "{{ [0, 1] }}",
                "as": "loopCopy",
                "index": "loopIndex"
              },
              "animate": {
                "opacity": {
                  "keyframes": [
                    {
                      "offset": 0,
                      "value": 0
                    },
                    {
                      "offset": 0,
                      "value": 0.7

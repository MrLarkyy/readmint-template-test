{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "Profile header",
  "description": "The name as a full-width poster line, then what the person does, what they work on and their status.",
  "canvas": {
    "width": 840,
    "height": 262
  },
  "assets": {
    "fonts": {
      "xb": {
        "family": "Archivo ExtraCondensed",
        "src": "fonts/ArchivoExtraCondensed-ExtraBold.ttf",
        "weight": 800,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        },
        "fallback": ["nxb"]
      },
      "scm": {
        "family": "Archivo SemiCondensed",
        "src": "fonts/ArchivoSemiCondensed-Medium.ttf",
        "weight": 500,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        },
        "fallback": ["nscm"]
      },
      "sc": {
        "family": "Archivo SemiCondensed",
        "src": "fonts/ArchivoSemiCondensed-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        },
        "fallback": ["nsc"]
      },
      "nxb": {
        "family": "Noto Sans",
        "src": "fonts/NotoSans-ExtraCondensedExtraBold.ttf",
        "weight": 800,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "nscm": {
        "family": "Noto Sans",
        "src": "fonts/NotoSans-SemiCondensedMedium.ttf",
        "weight": 500,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "nsc": {
        "family": "Noto Sans",
        "src": "fonts/NotoSans-SemiCondensed.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "mono": {
        "family": "Geist Mono",
        "src": "fonts/GeistMono-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        },
        "fallback": ["nm"]
      },
      "nm": {
        "family": "Noto Sans Mono",
        "src": "fonts/NotoSansMono-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "animation": {
    "duration": 60000,
    "loop": true
  },
  "components": {
    "card": {
      "props": {
        "theme": {
          "type": "enum",
          "values": ["light", "dark"],
          "default": "light"
        },
        "role": {
          "type": "string",
          "default": ""
        },
        "roleDetail": {
          "type": "string",
          "default": ""
        },
        "workingOn": {
          "type": "string",
          "default": ""
        },
        "workingOnDetail": {
          "type": "string",
          "default": ""
        },
        "statusNote": {
          "type": "string",
          "default": ""
        }
      },
      "layers": [
        {
          "type": "text",
          "x": 0,
          "y": 7.495,
          "content": "{{ \"~/\" + (github.login | truncate(40)) + \"/README.md\" }}",
          "font": "mono",
          "fontSize": 11,
          "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
        },
        {
          "type": "text",
          "x": 420,
          "width": 420,
          "align": "end",
          "y": 7.495,
          "content": "{{ (github.location ? (github.location | lower | truncate(30)) + \" · \" : \"\") + (github.contributions.to | date(\"d MMM yyyy\") | lower) }}",
          "font": "mono",
          "fontSize": 11,
          "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
        },
        {
          "type": "group",
          "let": {
            "nm": "{{ (github.name || github.login) | upper | truncate(40) }}",
            "fs": "{{ (8400 / ((nm | textWidth(\"xb\", 1, -0.01)) | max(0.01)) | floor) / 10 | min(124) }}"
          },
          "x": 0,
          "y": 20,
          "width": 840,
          "height": 150,
          "clip": true,
          "children": [
            {
              "type": "group",
              "x": 0,
              "y": -20,
              "children": [
                {
                  "type": "text",
                  "x": 0,
                  "y": "{{ 142 - fs * 0.934 }}",
                  "content": "{{ nm }}",
                  "font": "xb",
                  "fontSize": "{{ fs }}",
                  "letterSpacing": "{{ 0 - fs * 0.01 }}",
                  "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}"
                }
              ]
            }
          ]
        },
        {
          "type": "rect",
          "x": 0,
          "y": 170,
          "width": 840,
          "height": 1,
          "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}"
        },
        {
          "type": "group",
          "if": "{{ props.role || props.roleDetail }}",
          "children": [
            {
              "type": "text",
              "x": 0,
              "y": 185.495,
              "content": "role",
              "font": "mono",
              "fontSize": 11,
              "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
            },
            {
              "type": "group",
              "x": 0,
              "y": 200,
              "width": 270,
              "height": 26,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": 0,
                  "y": -200,
                  "children": [
                    {
                      "type": "text",
                      "x": 0,
                      "y": 204.122,
                      "content": "{{ props.role }}",
                      "font": "scm",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}",
                      "if": "{{ props.role }}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "group",
              "x": 0,
              "y": 226,
              "width": 270,
              "height": 24,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": 0,
                  "y": -226,
                  "children": [
                    {
                      "type": "text",
                      "x": 0,
                      "y": 227.122,
                      "content": "{{ props.roleDetail }}",
                      "font": "sc",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#CFCBC4\" : \"#3A3A3A\" }}",
                      "if": "{{ props.roleDetail }}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "if": "{{ props.workingOn || props.workingOnDetail }}",
          "children": [
            {
              "type": "text",
              "x": 290,
              "y": 185.495,
              "content": "working_on",
              "font": "mono",
              "fontSize": 11,
              "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
            },
            {
              "type": "group",
              "x": 290,
              "y": 200,
              "width": 270,
              "height": 26,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": -290,
                  "y": -200,
                  "children": [
                    {
                      "type": "text",
                      "x": 290,
                      "y": 204.122,
                      "content": "{{ props.workingOn }}",
                      "font": "scm",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}",
                      "if": "{{ props.workingOn }}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "group",
              "x": 290,
              "y": 226,
              "width": 270,
              "height": 24,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": -290,
                  "y": -226,
                  "children": [
                    {
                      "type": "text",
                      "x": 290,
                      "y": 227.122,
                      "content": "{{ props.workingOnDetail }}",
                      "font": "sc",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#CFCBC4\" : \"#3A3A3A\" }}",
                      "if": "{{ props.workingOnDetail }}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "if": "{{ github.status.message || props.statusNote }}",
          "children": [
            {
              "type": "text",
              "x": 580,
              "y": 185.495,
              "content": "status",
              "font": "mono",
              "fontSize": 11,
              "fill": "{{ props.theme == \"dark\" ? \"#948F88\" : \"#6E6E6E\" }}"
            },
            {
              "type": "ellipse",
              "x": 580.5,
              "y": 211.5,
              "if": "{{ github.status.message }}",
              "width": 7,
              "height": 7,
              "fill": "{{ props.theme == \"dark\" ? \"#FF8A3D\" : \"#E8590C\" }}"
            },
            {
              "type": "ellipse",
              "x": 580.5,
              "y": 211.5,
              "if": "{{ github.status.message }}",
              "width": 7,
              "height": 7,
              "fill": "none",
              "stroke": "{{ props.theme == \"dark\" ? \"#FF8A3D\" : \"#E8590C\" }}",
              "strokeWidth": 0.6,
              "animate": {
                "opacity": {
                  "keyframes": [
                    {
                      "offset": 0,
                      "value": 0
                    },
                    {
                      "offset": 0,
                      "value": 0.7
                    },
                    {
                      "offset": 1,
                      "value": 0
                    }
                  ],
                  "duration": 2000,
                  "cycles": 30
                },
                "scale": {
                  "keyframes": [
                    {
                      "offset": 0,
                      "value": 1
                    },
                    {
                      "offset": 1,
                      "value": 2.5
                    }
                  ],
                  "duration": 2000,
                  "cycles": 30
                }
              }
            },
            {
              "type": "group",
              "x": 596,
              "y": 200,
              "width": 254,
              "height": 26,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": -596,
                  "y": -200,
                  "children": [
                    {
                      "type": "text",
                      "x": 596,
                      "y": 204.122,
                      "content": "{{ github.status.message | truncateWidth(244, \"scm\", 17) }}",
                      "font": "scm",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}",
                      "if": "{{ github.status.message }}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "group",
              "x": 580,
              "y": "{{ github.status.message ? 226 : 203 }}",
              "width": 270,
              "height": 24,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": -580,
                  "y": -226,
                  "children": [
                    {
                      "type": "text",
                      "x": 580,
                      "y": 227.122,
                      "content": "{{ props.statusNote | truncateWidth(260, \"sc\", 17) }}",
                      "font": "sc",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#CFCBC4\" : \"#3A3A3A\" }}",
                      "if": "{{ props.statusNote }}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "light"
      }
    }
  ]
}

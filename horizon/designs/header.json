                    {
                      "offset": 1,
                      "value": 2.5
                    },
                    {
                      "offset": 1,
                      "value": 1
                    }
                  ],
                  "duration": 30000,
                  "stagger": 30000
                }
              }
            },
            {
              "type": "group",
              "x": 596,
              "y": 200,
              "width": 254,
              "height": 26,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": -596,
                  "y": -200,
                  "children": [
                    {
                      "type": "text",
                      "x": 596,
                      "y": 204.122,
                      "content": "{{ github.status.message }}",
                      "font": "scm",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#F0EEEA\" : \"#141414\" }}",
                      "if": "{{ github.status.message }}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "group",
              "x": 580,
              "y": 226,
              "width": 270,
              "height": 24,
              "clip": true,
              "children": [
                {
                  "type": "group",
                  "x": -580,
                  "y": -226,
                  "children": [
                    {
                      "type": "text",
                      "x": 580,
                      "y": 227.122,
                      "content": "{{ props.statusNote }}",
                      "font": "sc",
                      "fontSize": 17,
                      "fill": "{{ props.theme == \"dark\" ? \"#CFCBC4\" : \"#3A3A3A\" }}",
                      "if": "{{ props.statusNote }}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "light",
        "role": "Backend engineer",
        "roleDetail": "Kotlin & the JVM",
        "workingOn": "Messaging systems,",
        "workingOnDetail": "internal tooling",
        "statusNote": "Open to collaborations"
      }
    }
  ]

{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "Footer",
  "description": "A closing line, a note and how to get in touch, with the date of this render.",
  "canvas": {
    "width": 840,
    "height": 150
  },
  "assets": {
    "fonts": {
      "thin": {
        "family": "Archivo SemiExpanded",
        "src": "fonts/ArchivoSemiExpanded-Light.ttf",
        "weight": 300,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "med": {
        "family": "Archivo SemiExpanded",
        "src": "fonts/ArchivoSemiExpanded-Medium.ttf",
        "weight": 500,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "semi": {
        "family": "Archivo SemiExpanded",
        "src": "fonts/ArchivoSemiExpanded-SemiBold.ttf",
        "weight": 600,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "reg": {
        "family": "Archivo",
        "src": "fonts/Archivo-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "components": {
    "card": {
      "props": {
        "theme": {
          "type": "enum",
          "values": ["light", "dark"],
          "default": "light"
        },
        "headline": {
          "type": "string",
          "default": ""
        },
        "note": {
          "type": "string",
          "default": ""
        },
        "contactLabel": {
          "type": "string",
          "default": ""
        },
        "contactText": {
          "type": "string",
          "default": ""
        }
      },
      "layers": [
        {
          "type": "rect",
          "x": 0,
          "y": 0,
          "width": 840,
          "height": 1,
          "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
        },
        {
          "type": "group",
          "x": 0,
          "y": 20,
          "width": 560,
          "height": 55,
          "clip": true,
          "if": "{{ props.headline }}",
          "children": [
            {
              "type": "group",
              "x": 0,
              "y": -20,
              "children": [
                {
                  "type": "text",
                  "x": -1,
                  "y": 33.98,
                  "content": "{{ props.headline }}",
                  "font": "thin",
                  "fontSize": 30,
                  "letterSpacing": -0.3,
                  "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "x": 0,
          "y": 75,
          "width": 560,
          "height": 24,
          "clip": true,
          "if": "{{ props.note }}",
          "children": [
            {
              "type": "group",
              "x": 0,
              "y": -75,
              "children": [
                {
                  "type": "text",
                  "x": 0,
                  "y": 77.99,
                  "content": "{{ props.note }}",
                  "font": "reg",
                  "fontSize": 15,
                  "fill": "{{ props.theme == \"dark\" ? \"#C3C8CF\" : \"#3B3F47\" }}"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "x": 580,
          "width": 260,
          "align": "end",
          "y": 45.726,
          "content": "{{ (props.contactLabel || \"GitHub\") | upper | truncate(30) }}",
          "font": "semi",
          "fontSize": 11,
          "letterSpacing": 1.76,
          "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}"
        },
        {
          "type": "text",
          "x": "{{ 824 - ((props.contactText || \"github.com/\" + github.login) | truncate(32) | truncateWidth(300, \"med\", 17) | textWidth(\"med\", 17)) }}",
          "y": 68.122,
          "content": "{{ (props.contactText || \"github.com/\" + github.login) | truncate(32) | truncateWidth(300, \"med\", 17) }}",
          "font": "med",
          "fontSize": 17,
          "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
        },
        {
          "type": "path",
          "d": "M829 82 L837 74 M831 74 H837 V80",
          "fill": "none",
          "stroke": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}",
          "strokeWidth": 1.4
        },
        {
          "type": "rect",
          "x": "{{ 840 - (((props.contactText || \"github.com/\" + github.login) | truncate(32) | truncateWidth(300, \"med\", 17) | textWidth(\"med\", 17)) + 16) }}",
          "y": 90.25,
          "width": "{{ ((props.contactText || \"github.com/\" + github.login) | truncate(32) | truncateWidth(300, \"med\", 17) | textWidth(\"med\", 17)) + 16 }}",
          "height": 1.5,
          "fill": "{{ props.theme == \"dark\" ? \"#8C9BFF\" : \"#2B4BFF\" }}"
        },
        {
          "type": "text",
          "x": 0,
          "y": 127.726,
          "content": "{{ \"Rendered by Readmint on \" + (github.contributions.to | date(\"d MMM yyyy\")) + \".\" }}",
          "font": "reg",
          "fontSize": 11,
          "fill": "{{ props.theme == \"dark\" ? \"#7A828C\" : \"#6B7078\" }}"
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "dark"
      }
    }
  ]
}

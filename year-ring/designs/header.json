{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "Profile header",
  "description": "The name, a short introduction and the latest push typed out, next to a small turning ring of the last year.",
  "canvas": {
    "width": 840,
    "height": 262
  },
  "assets": {
    "fonts": {
      "thin": {
        "family": "Archivo SemiExpanded",
        "src": "fonts/ArchivoSemiExpanded-Light.ttf",
        "weight": 300,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "med": {
        "family": "Archivo SemiExpanded",
        "src": "fonts/ArchivoSemiExpanded-Medium.ttf",
        "weight": 500,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "semi": {
        "family": "Archivo SemiExpanded",
        "src": "fonts/ArchivoSemiExpanded-SemiBold.ttf",
        "weight": 600,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "reg": {
        "family": "Archivo",
        "src": "fonts/Archivo-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "bold": {
        "family": "Archivo",
        "src": "fonts/Archivo-SemiBold.ttf",
        "weight": 600,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "animation": {
    "duration": 60000,
    "loop": true
  },
  "components": {
    "card": {
      "props": {
        "theme": {
          "type": "enum",
          "values": ["light", "dark"],
          "default": "light"
        },
        "intro": {
          "type": "string",
          "default": ""
        }
      },
      "layers": [
        {
          "type": "text",
          "x": 0,
          "y": 11.726,
          "content": "{{ github.login | upper | truncate(40) | truncateWidth(400, \"semi\", 11, 1.76) }}",
          "font": "semi",
          "fontSize": 11,
          "letterSpacing": 1.76,
          "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}"
        },
        {
          "type": "text",
          "x": 420,
          "width": 420,
          "align": "end",
          "y": 11.726,
          "content": "{{ (github.location ? (github.location | upper | truncate(40) | truncateWidth(418 - ((\" · \" + (github.contributions.to | date(\"d MMM yyyy\") | upper)) | textWidth(\"med\", 11, 1.32)), \"med\", 11, 1.32)) + \" · \" : \"\") + (github.contributions.to | date(\"d MMM yyyy\") | upper) }}",
          "font": "med",
          "fontSize": 11,
          "letterSpacing": 1.32,
          "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}"
        },
        {
          "type": "rect",
          "x": 0,
          "y": 38,
          "width": 840,
          "height": 1,
          "fill": "{{ props.theme == \"dark\" ? \"#2A2F37\" : \"#DDE0E5\" }}"
        },
        {
          "type": "group",
          "x": -3,
          "y": 50,
          "width": 673,
          "height": 80,
          "clip": true,
          "children": [
            {
              "type": "group",
              "x": 3,
              "y": -50,
              "children": [
                {
                  "type": "text",
                  "x": -3,
                  "y": 61.564,
                  "content": "{{ (github.name || github.login) | truncate(20) }}",
                  "font": "thin",
                  "fontSize": 54,
                  "letterSpacing": -0.81,
                  "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "x": 0,
          "y": 133,
          "width": 690,
          "height": 50,
          "clip": true,
          "if": "{{ props.intro || github.bio }}",
          "children": [
            {
              "type": "group",
              "x": 0,
              "y": -133,
              "children": [
                {
                  "type": "text",
                  "x": 0,
                  "width": 600,
                  "y": 135.156,
                  "content": "{{ props.intro || github.bio }}",
                  "font": "reg",
                  "fontSize": 16,
                  "lineHeight": 1.4375,
                  "fill": "{{ props.theme == \"dark\" ? \"#C3C8CF\" : \"#3B3F47\" }}"
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "let": {
            "d": "{{ github.contributions.days }}",
            "n": "{{ d | length }}",
            "top": "{{ (github.contributions.days | max(\"count\")) || 0 }}",
            "mxs": "{{ (top <= 1 ? top : (top <= 4 ? 1 + (top - 1) / 3 * 1 : (top <= 9 ? 2 + (top - 4) / 5 * 1 : (top <= 16 ? 3 + (top - 9) / 7 * 1 : (top <= 36 ? 4 + (top - 16) / 20 * 2 : (top <= 64 ? 6 + (top - 36) / 28 * 2 : (top <= 100 ? 8 + (top - 64) / 36 * 2 : (top <= 169 ? 10 + (top - 100) / 69 * 3 : (top <= 256 ? 13 + (top - 169) / 87 * 3 : (top <= 400 ? 16 + (top - 256) / 144 * 4 : (top <= 1024 ? 20 + (top - 400) / 624 * 12 : (top <= 4096 ? 32 + (top - 1024) / 3072 * 32 : (top <= 16384 ? 64 + (top - 4096) / 12288 * 64 : 128))))))))))))) | max(1) }}"
          },
          "children": [
            {
              "type": "ellipse",
              "x": 687.79,
              "y": 98.822,
              "width": 128.419,
              "height": 42.536,
              "fill": {
                "type": "radial",
                "stops": [
                  {
                    "offset": 0,
                    "color": "{{ props.theme == \"dark\" ? \"#ECEEF20d\" : \"#15171C0d\" }}"
                  },
                  {
                    "offset": 1,
                    "color": "{{ props.theme == \"dark\" ? \"#ECEEF200\" : \"#15171C00\" }}"
                  }
                ]
              }
            },
            {
              "type": "ellipse",
              "x": 694.67,
              "y": 100.73,
              "width": 114.66,
              "height": 32.72,
              "fill": "none",
              "stroke": "{{ props.theme == \"dark\" ? \"#2A2F37\" : \"#DDE0E5\" }}",
              "strokeWidth": 1
            },
            {
              "type": "group",
              "repeat": {
                "each": "{{ d }}",
                "as": "day",
                "index": "k"
              },
              "if": "{{ k < n - 1 }}",
              "orbit": {
                "center": {
                  "x": 752,
                  "y": 117.09
                },
                "radius": 57.33,
                "radiusY": 16.36,
                "angle": "{{ (90 + 7.4485 + 345.1031 * k / ((n - 1) | max(1))) % 360 }}",
                "speed": -6
              },
              "children": [
                {
                  "type": "path",
                  "d": "M0 0 V{{ 0 - (day.count <= 1 ? day.count : (day.count <= 4 ? 1 + (day.count - 1) / 3 * 1 : (day.count <= 9 ? 2 + (day.count - 4) / 5 * 1 : (day.count <= 16 ? 3 + (day.count - 9) / 7 * 1 : (day.count <= 36 ? 4 + (day.count - 16) / 20 * 2 : (day.count <= 64 ? 6 + (day.count - 36) / 28 * 2 : (day.count <= 100 ? 8 + (day.count - 64) / 36 * 2 : (day.count <= 169 ? 10 + (day.count - 100) / 69 * 3 : (day.count <= 256 ? 13 + (day.count - 169) / 87 * 3 : (day.count <= 400 ? 16 + (day.count - 256) / 144 * 4 : (day.count <= 1024 ? 20 + (day.count - 400) / 624 * 12 : (day.count <= 4096 ? 32 + (day.count - 1024) / 3072 * 32 : (day.count <= 16384 ? 64 + (day.count - 4096) / 12288 * 64 : 128))))))))))))) / mxs * 15.29 | round(2) }}",
                  "fill": "none",
                  "stroke": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}",
                  "strokeWidth": 0.8,
                  "opacity": "{{ 0.22 + 0.78 * ((day.count <= 1 ? day.count : (day.count <= 4 ? 1 + (day.count - 1) / 3 * 1 : (day.count <= 9 ? 2 + (day.count - 4) / 5 * 1 : (day.count <= 16 ? 3 + (day.count - 9) / 7 * 1 : (day.count <= 36 ? 4 + (day.count - 16) / 20 * 2 : (day.count <= 64 ? 6 + (day.count - 36) / 28 * 2 : (day.count <= 100 ? 8 + (day.count - 64) / 36 * 2 : (day.count <= 169 ? 10 + (day.count - 100) / 69 * 3 : (day.count <= 256 ? 13 + (day.count - 169) / 87 * 3 : (day.count <= 400 ? 16 + (day.count - 256) / 144 * 4 : (day.count <= 1024 ? 20 + (day.count - 400) / 624 * 12 : (day.count <= 4096 ? 32 + (day.count - 1024) / 3072 * 32 : (day.count <= 16384 ? 64 + (day.count - 4096) / 12288 * 64 : 128))))))))))))) / mxs) }}",
                  "if": "{{ day.count > 0 }}"
                },
                {
                  "type": "ellipse",
                  "x": -0.6,
                  "y": -0.6,
                  "width": 1.2,
                  "height": 1.2,
                  "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}",
                  "opacity": 0.38,
                  "if": "{{ day.count == 0 }}"
                }
              ]
            },
            {
              "type": "group",
              "repeat": {
                "each": "{{ d }}",
                "as": "day",
                "index": "k"
              },
              "if": "{{ k == n - 1 }}",
              "orbit": {
                "center": {
                  "x": 752,
                  "y": 117.09
                },
                "radius": 57.33,
                "radiusY": 16.36,
                "angle": "{{ (90 + 7.4485 + 345.1031 * k / ((n - 1) | max(1))) % 360 }}",
                "speed": -6
              },
              "children": [
                {
                  "type": "path",
                  "d": "M0 0 V{{ 0 - ((day.count <= 1 ? day.count : (day.count <= 4 ? 1 + (day.count - 1) / 3 * 1 : (day.count <= 9 ? 2 + (day.count - 4) / 5 * 1 : (day.count <= 16 ? 3 + (day.count - 9) / 7 * 1 : (day.count <= 36 ? 4 + (day.count - 16) / 20 * 2 : (day.count <= 64 ? 6 + (day.count - 36) / 28 * 2 : (day.count <= 100 ? 8 + (day.count - 64) / 36 * 2 : (day.count <= 169 ? 10 + (day.count - 100) / 69 * 3 : (day.count <= 256 ? 13 + (day.count - 169) / 87 * 3 : (day.count <= 400 ? 16 + (day.count - 256) / 144 * 4 : (day.count <= 1024 ? 20 + (day.count - 400) / 624 * 12 : (day.count <= 4096 ? 32 + (day.count - 1024) / 3072 * 32 : (day.count <= 16384 ? 64 + (day.count - 4096) / 12288 * 64 : 128))))))))))))) / mxs * 15.29 | max(1.83)) }}",
                  "fill": "none",
                  "stroke": "{{ props.theme == \"dark\" ? \"#8C9BFF\" : \"#2B4BFF\" }}",
                  "strokeWidth": 1.44
                },
                {
                  "type": "ellipse",
                  "x": -1.92,
                  "y": "{{ 0 - ((day.count <= 1 ? day.count : (day.count <= 4 ? 1 + (day.count - 1) / 3 * 1 : (day.count <= 9 ? 2 + (day.count - 4) / 5 * 1 : (day.count <= 16 ? 3 + (day.count - 9) / 7 * 1 : (day.count <= 36 ? 4 + (day.count - 16) / 20 * 2 : (day.count <= 64 ? 6 + (day.count - 36) / 28 * 2 : (day.count <= 100 ? 8 + (day.count - 64) / 36 * 2 : (day.count <= 169 ? 10 + (day.count - 100) / 69 * 3 : (day.count <= 256 ? 13 + (day.count - 169) / 87 * 3 : (day.count <= 400 ? 16 + (day.count - 256) / 144 * 4 : (day.count <= 1024 ? 20 + (day.count - 400) / 624 * 12 : (day.count <= 4096 ? 32 + (day.count - 1024) / 3072 * 32 : (day.count <= 16384 ? 64 + (day.count - 4096) / 12288 * 64 : 128))))))))))))) / mxs * 15.29 | max(1.83)) - 1.92 }}",
                  "width": 3.84,
                  "height": 3.84,
                  "fill": "{{ props.theme == \"dark\" ? \"#8C9BFF\" : \"#2B4BFF\" }}"
                }
              ]
            },
            {
              "type": "ellipse",
              "x": 675.79,
              "y": 74.279,
              "width": 152.419,
              "height": 45.265,
              "fill": {
                "type": "radial",
                "stops": [
                  {
                    "offset": 0,
                    "color": "{{ (props.theme == \"dark\" ? \"#0d1117\" : \"#ffffff\") + \"b3\" }}"
                  },
                  {
                    "offset": 0.55,
                    "color": "{{ (props.theme == \"dark\" ? \"#0d1117\" : \"#ffffff\") + \"73\" }}"
                  },
                  {
                    "offset": 1,
                    "color": "{{ (props.theme == \"dark\" ? \"#0d1117\" : \"#ffffff\") + \"00\" }}"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "ellipse",
          "x": 1,
          "y": 219,
          "width": 8,
          "height": 8,
          "fill": "{{ props.theme == \"dark\" ? \"#8C9BFF\" : \"#2B4BFF\" }}",
          "if": "{{ github.pushes[0] }}"
        },
        {
          "type": "ellipse",
          "x": 1,
          "y": 219,
          "width": 8,
          "height": 8,
          "fill": "none",
          "stroke": "{{ props.theme == \"dark\" ? \"#8C9BFF\" : \"#2B4BFF\" }}",
          "strokeWidth": 0.6,
          "animate": {
            "opacity": {
              "keyframes": [
                {
                  "offset": 0,
                  "value": 0
                },
                {
                  "offset": 0,
                  "value": 0.7
                },
                {
                  "offset": 1,
                  "value": 0
                }
              ],
              "duration": 2000,
              "cycles": 30
            },
            "scale": {
              "keyframes": [
                {
                  "offset": 0,
                  "value": 1
                },
                {
                  "offset": 1,
                  "value": 2.5
                }
              ],
              "duration": 2000,
              "cycles": 30
            }
          },
          "if": "{{ github.pushes[0] }}"
        },
        {
          "type": "group",
          "let": {
            "d": "{{ github.contributions.days }}",
            "n": "{{ d | length }}"
          },
          "if": "{{ github.pushes[0] }}",
          "x": 18,
          "y": 0,
          "layout": {
            "type": "stack",
            "direction": "row",
            "gap": 10
          },
          "children": [
            {
              "type": "text",
              "x": 0,
              "y": 214.924,
              "content": "{{ \"Last push \" + ((github.pushes[0].date | date(\"yyyy-MM-dd\")) == d[n - 1].date ? \"today\" : ((github.pushes[0].date | date(\"yyyy-MM-dd\")) == d[n - 2].date ? \"yesterday\" : ((github.pushes[0].date | date(\"yyyy-MM-dd\")) == d[n - 3].date ? \"2 days ago\" : ((github.pushes[0].date | date(\"yyyy-MM-dd\")) == d[n - 4].date ? \"3 days ago\" : ((github.pushes[0].date | date(\"yyyy-MM-dd\")) == d[n - 5].date ? \"4 days ago\" : ((github.pushes[0].date | date(\"yyyy-MM-dd\")) == d[n - 6].date ? \"5 days ago\" : ((github.pushes[0].date | date(\"yyyy-MM-dd\")) == d[n - 7].date ? \"6 days ago\" : (github.pushes[0].date | date(\"MMM d\"))))))))) }}",
              "font": "bold",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
            },
            {
              "type": "text",
              "x": 0,
              "y": 214.924,
              "content": "{{ \"·  \" + (github.pushes[0].repository | truncate(18)) + \"  ·\" }}",
              "font": "reg",
              "fontSize": 14,
              "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}"
            },
            {
              "type": "group",
              "children": [
                {
                  "type": "group",
                  "width": 900,
                  "height": 22.4,
                  "y": 212.124,
                  "clip": true,
                  "animate": {
                    "x": {
                      "keyframes": [
                        {
                          "offset": 0,
                          "value": 0
                        },
                        {
                          "offset": 0,
                          "value": -900
                        },
                        {
                          "offset": 0.999,
                          "value": "{{ ((github.pushes[0].message | truncate(60) | textWidth(\"reg\", 14))) - 900 }}"
                        },
                        {
                          "offset": 1,
                          "value": 0
                        }
                      ],
                      "duration": "{{ ((github.pushes[0].message | truncate(60) | length) | max(1)) * 55 }}"
                    }
                  },
                  "children": [
                    {
                      "type": "text",
                      "x": 0,
                      "y": 2.8,
                      "content": "{{ github.pushes[0].message | truncate(60) }}",
                      "font": "reg",
                      "fontSize": 14,
                      "fill": "{{ props.theme == \"dark\" ? \"#C3C8CF\" : \"#3B3F47\" }}",
                      "animate": {
                        "x": {
                          "keyframes": [
                            {
                              "offset": 0,
                              "value": 0
                            },
                            {
                              "offset": 0,
                              "value": 900
                            },
                            {
                              "offset": 0.999,
                              "value": "{{ 900 - ((github.pushes[0].message | truncate(60) | textWidth(\"reg\", 14))) }}"
                            },
                            {
                              "offset": 1,
                              "value": 0
                            }
                          ],
                          "duration": "{{ ((github.pushes[0].message | truncate(60) | length) | max(1)) * 55 }}"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "group",
                  "layout": {
                    "type": "stack",
                    "direction": "row",
                    "gap": 0
                  },
                  "children": [
                    {
                      "type": "text",
                      "x": 0,
                      "y": 214.924,
                      "content": "{{ github.pushes[0].message | truncate(60) }}",
                      "font": "reg",
                      "fontSize": 14,
                      "fill": "{{ props.theme == \"dark\" ? \"#C3C8CF\" : \"#3B3F47\" }}",
                      "opacity": 0
                    },
                    {
                      "type": "group",
                      "width": 12,
                      "height": 19.6,
                      "children": [
                        {
                          "type": "rect",
                          "x": 2,
                          "y": 216.52,
                          "width": 1.6,
                          "height": 14.28,
                          "fill": "{{ props.theme == \"dark\" ? \"#8C9BFF\" : \"#2B4BFF\" }}",
                          "animate": {
                            "opacity": {
                              "keyframes": [
                                {
                                  "offset": 0,
                                  "value": 0
                                },
                                {
                                  "offset": 0,
                                  "value": 1
                                },
                                {
                                  "offset": 0.5,
                                  "value": 1
                                },
                                {
                                  "offset": 0.5,
                                  "value": 0
                                },
                                {
                                  "offset": 1,
                                  "value": 0
                                }
                              ],
                              "duration": 1000,
                              "cycles": 60
                            }
                          }
                        }
                      ],
                      "animate": {
                        "x": {
                          "keyframes": [
                            {
                              "offset": 0,
                              "value": 0
                            },
                            {
                              "offset": 0,
                              "value": "{{ 0 - ((github.pushes[0].message | truncate(60) | textWidth(\"reg\", 14))) }}"
                            },
                            {
                              "offset": 0.999,
                              "value": 0
                            },
                            {
                              "offset": 1,
                              "value": 0
                            }
                          ],
                          "duration": "{{ ((github.pushes[0].message | truncate(60) | length) | max(1)) * 55 }}"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "x": 0,
          "y": 214.924,
          "content": "No recent push yet.",
          "font": "reg",
          "fontSize": 14,
          "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}",
          "if": "{{ !github.pushes[0] }}"
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "light"
      }
    }
  ]
}

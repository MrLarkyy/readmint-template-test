{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "Index",
  "description": "Key facts in rows, with the languages of the public repositories and a bar of their shares.",
  "canvas": {
    "width": 840,
    "height": 340
  },
  "assets": {
    "fonts": {
      "semi": {
        "family": "Archivo SemiExpanded",
        "src": "fonts/ArchivoSemiExpanded-SemiBold.ttf",
        "weight": 600,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "reg": {
        "family": "Archivo",
        "src": "fonts/Archivo-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "animation": {
    "duration": 2200,
    "loop": false
  },
  "components": {
    "card": {
      "props": {
        "theme": {
          "type": "enum",
          "values": [
            "light",
            "dark"
          ],
          "default": "light"
        },
        "labels": {
          "type": "array",
          "default": []
        },
        "values": {
          "type": "array",
          "default": []
        },
        "languagesAfter": {
          "type": "number",
          "default": 2
        }
      },
      "layers": [
        {
          "type": "text",
          "x": 0,
          "y": 9.726,
          "content": "INDEX",
          "font": "semi",
          "fontSize": 11,
          "letterSpacing": 1.76,
          "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
        },
        {
          "type": "rect",
          "x": 0,
          "y": 34,
          "width": 840,
          "height": 1,
          "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
        },
        {
          "type": "group",
          "repeat": {
            "each": "{{ props.labels }}",
            "as": "label",
            "index": "i"
          },
          "if": "{{ (i < props.languagesAfter ? i : i + (((github.languages | length | default(0)) > 0) ? 1 : 0)) < 8 }}",
          "children": [
            {
              "type": "group",
              "x": 0,
              "y": "{{ 48 + (i < props.languagesAfter ? i : i + (((github.languages | length | default(0)) > 0) ? 1 : 0)) * 36 }}",
              "children": [
                {
                  "type": "text",
                  "x": 0,
                  "y": 3.858,
                  "content": "{{ label | truncate(24) }}",
                  "font": "reg",
                  "fontSize": 13,
                  "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}"
                },
                {
                  "type": "text",
                  "x": 170,
                  "y": 1.99,
                  "content": "{{ props.values[i] | default(\"\") | truncate(80) }}",
                  "font": "reg",
                  "fontSize": 15,
                  "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
                },
                {
                  "type": "rect",
                  "x": 0,
                  "y": 35,
                  "width": 840,
                  "height": 1,
                  "fill": "{{ props.theme == \"dark\" ? \"#2A2F37\" : \"#DDE0E5\" }}"
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "x": 0,
          "y": "{{ 48 + (props.languagesAfter | clamp(0, (props.labels | length))) * 36 }}",
          "if": "{{ ((github.languages | length | default(0)) > 0) }}",
          "children": [
            {
              "type": "text",
              "x": 0,
              "y": 3.858,
              "content": "Languages",
              "font": "reg",
              "fontSize": 13,
              "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}"
            },
            {
              "type": "group",
              "x": 170,
              "y": 0,
              "layout": {
                "type": "stack",
                "direction": "row",
                "gap": 22
              },
              "children": [
                {
                  "type": "group",
                  "repeat": {
                    "each": "{{ [github.languages[0], github.languages[1], github.languages[2]] }}",
                    "as": "lang"
                  },
                  "if": "{{ lang }}",
                  "children": [
                    {
                      "type": "text",
                      "x": 0,
                      "y": 1.99,
                      "content": "{{ lang.name }} {{ lang.share * 100 | round }}%",
                      "font": "reg",
                      "fontSize": 15,
                      "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "group",
              "x": "{{ 520 + 320 * (0) }}",
              "y": 8,
              "width": "{{ (320 * (github.languages[0].share | default(0)) - 2 | max(0)) | max(0.001) }}",
              "height": 5,
              "clip": true,
              "if": "{{ (320 * (github.languages[0].share | default(0)) - 2 | max(0)) > 0.5 }}",
              "children": [
                {
                  "type": "rect",
                  "x": 0,
                  "y": 0,
                  "width": "{{ (320 * (github.languages[0].share | default(0)) - 2 | max(0)) | max(0.001) }}",
                  "height": 5,
                  "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}",
                  "animate": {
                    "x": {
                      "keyframes": [
                        {
                          "offset": 0,
                          "value": 0
                        },
                        {
                          "offset": 0,
                          "value": "{{ 0 - (320 * (github.languages[0].share | default(0)) - 2 | max(0)) }}"
                        },
                        {
                          "offset": 0.2143,
                          "value": "{{ 0 - (320 * (github.languages[0].share | default(0)) - 2 | max(0)) }}",
                          "easing": {
                            "x1": 0.2,
                            "y1": 0.8,
                            "x2": 0.3,
                            "y2": 1
                          }
                        },
                        {
                          "offset": 1,
                          "value": 0
                        }
                      ],
                      "duration": 1400
                    }
                  }
                }
              ]
            },
            {
              "type": "group",
              "x": "{{ 520 + 320 * ((github.languages[0].share | default(0))) }}",
              "y": 8,
              "width": "{{ (320 * (github.languages[1].share | default(0)) - 2 | max(0)) | max(0.001) }}",
              "height": 5,
              "clip": true,
              "if": "{{ (320 * (github.languages[1].share | default(0)) - 2 | max(0)) > 0.5 }}",
              "children": [
                {
                  "type": "rect",
                  "x": 0,
                  "y": 0,
                  "width": "{{ (320 * (github.languages[1].share | default(0)) - 2 | max(0)) | max(0.001) }}",
                  "height": 5,
                  "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}",
                  "animate": {
                    "x": {
                      "keyframes": [
                        {
                          "offset": 0,
                          "value": 0
                        },
                        {
                          "offset": 0,
                          "value": "{{ 0 - (320 * (github.languages[1].share | default(0)) - 2 | max(0)) }}"
                        },
                        {
                          "offset": 0.3333,
                          "value": "{{ 0 - (320 * (github.languages[1].share | default(0)) - 2 | max(0)) }}",
                          "easing": {
                            "x1": 0.2,
                            "y1": 0.8,
                            "x2": 0.3,
                            "y2": 1
                          }
                        },
                        {
                          "offset": 1,
                          "value": 0
                        }
                      ],
                      "duration": 1650
                    }
                  }
                }
              ]
            },
            {
              "type": "group",
              "x": "{{ 520 + 320 * ((github.languages[0].share | default(0)) + (github.languages[1].share | default(0))) }}",
              "y": 8,
              "width": "{{ (320 * (github.languages[2].share | default(0)) - 2 | max(0)) | max(0.001) }}",
              "height": 5,
              "clip": true,
              "if": "{{ (320 * (github.languages[2].share | default(0)) - 2 | max(0)) > 0.5 }}",
              "children": [
                {
                  "type": "rect",
                  "x": 0,
                  "y": 0,
                  "width": "{{ (320 * (github.languages[2].share | default(0)) - 2 | max(0)) | max(0.001) }}",
                  "height": 5,
                  "fill": "{{ props.theme == \"dark\" ? \"#5A616B\" : \"#A1A6AE\" }}",
                  "animate": {
                    "x": {
                      "keyframes": [
                        {
                          "offset": 0,
                          "value": 0
                        },
                        {
                          "offset": 0,
                          "value": "{{ 0 - (320 * (github.languages[2].share | default(0)) - 2 | max(0)) }}"
                        },
                        {
                          "offset": 0.4211,
                          "value": "{{ 0 - (320 * (github.languages[2].share | default(0)) - 2 | max(0)) }}",
                          "easing": {
                            "x1": 0.2,
                            "y1": 0.8,
                            "x2": 0.3,
                            "y2": 1
                          }
                        },
                        {
                          "offset": 1,
                          "value": 0
                        }
                      ],
                      "duration": 1900
                    }
                  }
                }
              ]
            },
            {
              "type": "group",
              "x": "{{ 520 + 320 * ((github.languages[0].share | default(0)) + (github.languages[1].share | default(0)) + (github.languages[2].share | default(0))) }}",
              "y": 8,
              "width": "{{ (320 * (1 - (github.languages[0].share | default(0)) - (github.languages[1].share | default(0)) - (github.languages[2].share | default(0)) | max(0)) - 0 | max(0)) | max(0.001) }}",
              "height": 5,
              "clip": true,
              "if": "{{ (320 * (1 - (github.languages[0].share | default(0)) - (github.languages[1].share | default(0)) - (github.languages[2].share | default(0)) | max(0)) - 0 | max(0)) > 0.5 }}",
              "children": [
                {
                  "type": "rect",
                  "x": 0,
                  "y": 0,
                  "width": "{{ (320 * (1 - (github.languages[0].share | default(0)) - (github.languages[1].share | default(0)) - (github.languages[2].share | default(0)) | max(0)) - 0 | max(0)) | max(0.001) }}",
                  "height": 5,
                  "fill": "{{ props.theme == \"dark\" ? \"#2A2F37\" : \"#DDE0E5\" }}",
                  "animate": {
                    "x": {
                      "keyframes": [
                        {
                          "offset": 0,
                          "value": 0
                        },
                        {
                          "offset": 0,
                          "value": "{{ 0 - (320 * (1 - (github.languages[0].share | default(0)) - (github.languages[1].share | default(0)) - (github.languages[2].share | default(0)) | max(0)) - 0 | max(0)) }}"
                        },
                        {
                          "offset": 0.4884,
                          "value": "{{ 0 - (320 * (1 - (github.languages[0].share | default(0)) - (github.languages[1].share | default(0)) - (github.languages[2].share | default(0)) | max(0)) - 0 | max(0)) }}",
                          "easing": {
                            "x1": 0.2,
                            "y1": 0.8,
                            "x2": 0.3,
                            "y2": 1
                          }
                        },
                        {
                          "offset": 1,
                          "value": 0
                        }
                      ],
                      "duration": 2150
                    }
                  }
                }
              ]
            },
            {
              "type": "rect",
              "x": 0,
              "y": 35,
              "width": 840,
              "height": 1,
              "fill": "{{ props.theme == \"dark\" ? \"#2A2F37\" : \"#DDE0E5\" }}"
            }
          ]
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "light",
        "labels": [
          "Focus",
          "Systems",
          "Frameworks",
          "Data",
          "Tools",
          "Shipped for",
          "Creators"
        ],
        "values": [
          "Backend systems and internal tooling",
          "Messaging with Redis, RabbitMQ and NATS",
          "Ktor, Spring",
          "PostgreSQL, MySQL, MariaDB, SQLite, Protocol Buffers",
          "IntelliJ IDEA, Rider, WebStorm, Gradle",
          "Hoplite, Minebox, Cobblemon Islands, Mineclub",
          "MrBeast, SpeedSilver, DiamondXR"
        ],
        "languagesAfter": 2
      }
    }
  ]
}

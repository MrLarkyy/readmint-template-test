{
  "$schema": "https://raw.githubusercontent.com/MrLarkyy/Readmint/main/packages/format/schema/design-v0.schema.json",
  "version": 0,
  "title": "Index",
  "description": "Key facts in rows, with the languages of the public repositories and a bar of their shares.",
  "canvas": {
    "width": 840,
    "height": "{{ 39 + 36 * ((props.labels | length) + ((github.languages | length | default(0)) > 0 ? 1 : 0) | min(8)) + (((props.logoNames | length | min(12)) > 0 && props.logosRow >= 0 && props.logosRow < (props.labels | length) && props.logosRow == (props.logosRow | floor) && (props.logosRow < props.languagesAfter ? props.logosRow : props.logosRow + ((github.languages | length | default(0)) > 0 ? 1 : 0)) < 8) ? 24 * ((props.logoLabels | length | clamp(1, 4)) - 1) : 0) }}"
  },
  "assets": {
    "fonts": {
      "semi": {
        "family": "Archivo SemiExpanded",
        "src": "fonts/ArchivoSemiExpanded-SemiBold.ttf",
        "weight": 600,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      },
      "reg": {
        "family": "Archivo",
        "src": "fonts/Archivo-Regular.ttf",
        "weight": 400,
        "licence": {
          "embedding": "allowed",
          "name": "OFL-1.1"
        }
      }
    }
  },
  "animation": {
    "duration": 2200,
    "loop": false
  },
  "components": {
    "card": {
      "props": {
        "theme": {
          "type": "enum",
          "values": ["light", "dark"],
          "default": "light"
        },
        "labels": {
          "type": "array",
          "default": []
        },
        "values": {
          "type": "array",
          "default": []
        },
        "languagesAfter": {
          "type": "number",
          "default": 2
        },
        "logoLabels": {
          "type": "array",
          "default": []
        },
        "logoFills": {
          "type": "array",
          "default": []
        },
        "logoFillsDark": {
          "type": "array",
          "default": []
        },
        "logoLines": {
          "type": "array",
          "default": []
        },
        "logoLayers": {
          "type": "array",
          "default": []
        },
        "logoNames": {
          "type": "array",
          "default": []
        },
        "logoWithName": {
          "type": "array",
          "default": []
        },
        "logos": {
          "type": "array",
          "default": []
        },
        "logosRow": {
          "type": "number",
          "default": -1
        }
      },
      "layers": [
        {
          "type": "group",
          "repeat": {
            "each": "{{ [((props.logoNames | length | min(12)) > 0 && props.logosRow >= 0 && props.logosRow < (props.labels | length) && props.logosRow == (props.logosRow | floor) && (props.logosRow < props.languagesAfter ? props.logosRow : props.logosRow + ((github.languages | length | default(0)) > 0 ? 1 : 0)) < 8) ? props.logosRow : -1] }}",
            "as": "sr"
          },
          "children": [
            {
              "type": "text",
              "x": 0,
              "y": 9.726,
              "content": "INDEX",
              "font": "semi",
              "fontSize": 11,
              "letterSpacing": 1.76,
              "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
            },
            {
              "type": "rect",
              "x": 0,
              "y": 34,
              "width": 840,
              "height": 1,
              "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
            },
            {
              "type": "group",
              "repeat": {
                "each": "{{ props.labels }}",
                "as": "label",
                "index": "i"
              },
              "if": "{{ (i < props.languagesAfter ? i : i + (((github.languages | length | default(0)) > 0) ? 1 : 0)) < 8 }}",
              "children": [
                {
                  "type": "group",
                  "x": 0,
                  "y": "{{ 35 + (i < props.languagesAfter ? i : i + (((github.languages | length | default(0)) > 0) ? 1 : 0)) * 36 + (i > sr ? (sr >= 0 ? 24 * ((props.logoLabels | length | clamp(1, 4)) - 1) : 0) : 0) }}",
                  "children": [
                    {
                      "type": "text",
                      "x": 0,
                      "y": 10.16,
                      "content": "{{ label | truncate(24) }}",
                      "font": "reg",
                      "fontSize": 13,
                      "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}"
                    },
                    {
                      "type": "text",
                      "x": 170,
                      "y": 8.292,
                      "content": "{{ props.values[i] | default(\"\") | truncate(80) }}",
                      "font": "reg",
                      "fontSize": 15,
                      "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}",
                      "if": "{{ !(i == sr) }}"
                    },
                    {
                      "type": "group",
                      "if": "{{ (i == sr) }}",
                      "children": [
                        {
                          "type": "rect",
                          "x": 162,
                          "y": 3,
                          "width": 678,
                          "height": "{{ 30 + 24 * ((props.logoLabels | length | clamp(1, 4)) - 1) }}",
                          "radius": 6,
                          "fill": "{{ props.theme == \"dark\" ? \"#1A1E24\" : \"#F4F5F7\" }}"
                        },
                        {
                          "type": "group",
                          "repeat": {
                            "each": "{{ (props.logoLabels | length) > 0 ? props.logoLabels : [\"\"] }}",
                            "as": "cap",
                            "index": "g"
                          },
                          "if": "{{ g < 4 }}",
                          "x": 0,
                          "y": "{{ 9 + 24 * g }}",
                          "children": [
                            {
                              "type": "text",
                              "x": 174,
                              "y": 3.5,
                              "content": "{{ cap | upper | truncateWidth(108, \"semi\", 10, 1.4) }}",
                              "font": "semi",
                              "fontSize": 10,
                              "letterSpacing": 1.4,
                              "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}"
                            },
                            {
                              "type": "group",
                              "x": "{{ 174 + ((props.logoLabels | join(\"\")) ? 120 : 0) }}",
                              "y": 0,
                              "width": "{{ 832 - (174 + ((props.logoLabels | join(\"\")) ? 120 : 0)) }}",
                              "height": 18,
                              "clip": true,
                              "layout": {
                                "type": "stack",
                                "direction": "row",
                                "gap": 24,
                                "align": "center"
                              },
                              "children": [
                                {
                                  "type": "group",
                                  "repeat": {
                                    "each": "{{ props.logoNames }}",
                                    "as": "name",
                                    "index": "k"
                                  },
                                  "if": "{{ k < 12 && ((props.logoLines[k] | default(\"0\")) | padStart(1)) == (g | padStart(1)) }}",
                                  "layout": {
                                    "type": "stack",
                                    "direction": "row",
                                    "gap": 7,
                                    "align": "center"
                                  },
                                  "children": [
                                    {
                                      "type": "group",
                                      "if": "{{ props.logoLayers[4 * k] }}",
                                      "children": [
                                        {
                                          "type": "group",
                                          "repeat": {
                                            "each": "{{ [4 * k, 4 * k + 1, 4 * k + 2, 4 * k + 3] }}",
                                            "as": "li"
                                          },
                                          "if": "{{ props.logoLayers[li] }}",
                                          "children": [
                                            {
                                              "type": "path",
                                              "d": "{{ props.logoLayers[li] }}",
                                              "fill": "{{ props.theme == \"dark\" ? (props.logoFillsDark[li] || props.logoFills[li] || \"#ECEEF2\") : (props.logoFills[li] || \"#15171C\") }}"
                                            }
                                          ]
                                        }
                                      ]
                                    },
                                    {
                                      "type": "path",
                                      "d": "{{ props.logos[k] }}",
                                      "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}",
                                      "if": "{{ !props.logoLayers[4 * k] && props.logos[k] }}"
                                    },
                                    {
                                      "type": "text",
                                      "content": "{{ name | truncate(24) }}",
                                      "font": "reg",
                                      "fontSize": 13,
                                      "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}",
                                      "if": "{{ !(props.logoLayers[4 * k] || props.logos[k]) || props.logoWithName[k] }}"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "rect",
                      "x": 0,
                      "y": "{{ 35 + (i == sr ? (sr >= 0 ? 24 * ((props.logoLabels | length | clamp(1, 4)) - 1) : 0) : 0) }}",
                      "width": 840,
                      "height": 1,
                      "fill": "{{ props.theme == \"dark\" ? \"#2A2F37\" : \"#DDE0E5\" }}"
                    }
                  ]
                }
              ]
            },
            {
              "type": "group",
              "x": 0,
              "y": "{{ 35 + (props.languagesAfter | clamp(0, (props.labels | length))) * 36 + ((props.languagesAfter | clamp(0, (props.labels | length))) > sr ? (sr >= 0 ? 24 * ((props.logoLabels | length | clamp(1, 4)) - 1) : 0) : 0) }}",
              "if": "{{ ((github.languages | length | default(0)) > 0) && (props.languagesAfter | clamp(0, (props.labels | length))) < 8 }}",
              "children": [
                {
                  "type": "text",
                  "x": 0,
                  "y": 10.16,
                  "content": "Languages",
                  "font": "reg",
                  "fontSize": 13,
                  "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}"
                },
                {
                  "type": "group",
                  "x": 170,
                  "y": 0,
                  "layout": {
                    "type": "stack",
                    "direction": "row",
                    "gap": 22
                  },
                  "children": [
                    {
                      "type": "group",
                      "repeat": {
                        "each": "{{ [github.languages[0], github.languages[1], github.languages[2]] }}",
                        "as": "lang"
                      },
                      "if": "{{ lang }}",
                      "children": [
                        {
                          "type": "text",
                          "x": 0,
                          "y": 8.292,
                          "content": "{{ lang.name }} {{ lang.share * 100 | round }}%",
                          "font": "reg",
                          "fontSize": 15,
                          "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "group",
                  "x": "{{ 520 + 320 * (0) }}",
                  "y": 15,
                  "width": "{{ (320 * (github.languages[0].share | default(0)) - 2 | max(0)) | max(0.001) }}",
                  "height": 5,
                  "clip": true,
                  "if": "{{ (320 * (github.languages[0].share | default(0)) - 2 | max(0)) > 0.5 }}",
                  "children": [
                    {
                      "type": "rect",
                      "x": 0,
                      "y": 0,
                      "width": "{{ (320 * (github.languages[0].share | default(0)) - 2 | max(0)) | max(0.001) }}",
                      "height": 5,
                      "fill": "{{ props.theme == \"dark\" ? \"#ECEEF2\" : \"#15171C\" }}",
                      "animate": {
                        "x": {
                          "keyframes": [
                            {
                              "offset": 0,
                              "value": 0
                            },
                            {
                              "offset": 0,
                              "value": "{{ 0 - (320 * (github.languages[0].share | default(0)) - 2 | max(0)) }}"
                            },
                            {
                              "offset": 0.2143,
                              "value": "{{ 0 - (320 * (github.languages[0].share | default(0)) - 2 | max(0)) }}",
                              "easing": {
                                "x1": 0.2,
                                "y1": 0.8,
                                "x2": 0.3,
                                "y2": 1
                              }
                            },
                            {
                              "offset": 1,
                              "value": 0
                            }
                          ],
                          "duration": 1400
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "group",
                  "x": "{{ 520 + 320 * ((github.languages[0].share | default(0))) }}",
                  "y": 15,
                  "width": "{{ (320 * (github.languages[1].share | default(0)) - 2 | max(0)) | max(0.001) }}",
                  "height": 5,
                  "clip": true,
                  "if": "{{ (320 * (github.languages[1].share | default(0)) - 2 | max(0)) > 0.5 }}",
                  "children": [
                    {
                      "type": "rect",
                      "x": 0,
                      "y": 0,
                      "width": "{{ (320 * (github.languages[1].share | default(0)) - 2 | max(0)) | max(0.001) }}",
                      "height": 5,
                      "fill": "{{ props.theme == \"dark\" ? \"#8E949D\" : \"#696E77\" }}",
                      "animate": {
                        "x": {
                          "keyframes": [
                            {
                              "offset": 0,
                              "value": 0
                            },
                            {
                              "offset": 0,
                              "value": "{{ 0 - (320 * (github.languages[1].share | default(0)) - 2 | max(0)) }}"
                            },
                            {
                              "offset": 0.3333,
                              "value": "{{ 0 - (320 * (github.languages[1].share | default(0)) - 2 | max(0)) }}",
                              "easing": {
                                "x1": 0.2,
                                "y1": 0.8,
                                "x2": 0.3,
                                "y2": 1
                              }
                            },
                            {
                              "offset": 1,
                              "value": 0
                            }
                          ],
                          "duration": 1650
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "group",
                  "x": "{{ 520 + 320 * ((github.languages[0].share | default(0)) + (github.languages[1].share | default(0))) }}",
                  "y": 15,
                  "width": "{{ (320 * (github.languages[2].share | default(0)) - 2 | max(0)) | max(0.001) }}",
                  "height": 5,
                  "clip": true,
                  "if": "{{ (320 * (github.languages[2].share | default(0)) - 2 | max(0)) > 0.5 }}",
                  "children": [
                    {
                      "type": "rect",
                      "x": 0,
                      "y": 0,
                      "width": "{{ (320 * (github.languages[2].share | default(0)) - 2 | max(0)) | max(0.001) }}",
                      "height": 5,
                      "fill": "{{ props.theme == \"dark\" ? \"#5A616B\" : \"#A1A6AE\" }}",
                      "animate": {
                        "x": {
                          "keyframes": [
                            {
                              "offset": 0,
                              "value": 0
                            },
                            {
                              "offset": 0,
                              "value": "{{ 0 - (320 * (github.languages[2].share | default(0)) - 2 | max(0)) }}"
                            },
                            {
                              "offset": 0.4211,
                              "value": "{{ 0 - (320 * (github.languages[2].share | default(0)) - 2 | max(0)) }}",
                              "easing": {
                                "x1": 0.2,
                                "y1": 0.8,
                                "x2": 0.3,
                                "y2": 1
                              }
                            },
                            {
                              "offset": 1,
                              "value": 0
                            }
                          ],
                          "duration": 1900
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "group",
                  "x": "{{ 520 + 320 * ((github.languages[0].share | default(0)) + (github.languages[1].share | default(0)) + (github.languages[2].share | default(0))) }}",
                  "y": 15,
                  "width": "{{ (320 * (1 - (github.languages[0].share | default(0)) - (github.languages[1].share | default(0)) - (github.languages[2].share | default(0)) | max(0)) - 0 | max(0)) | max(0.001) }}",
                  "height": 5,
                  "clip": true,
                  "if": "{{ (320 * (1 - (github.languages[0].share | default(0)) - (github.languages[1].share | default(0)) - (github.languages[2].share | default(0)) | max(0)) - 0 | max(0)) > 0.5 }}",
                  "children": [
                    {
                      "type": "rect",
                      "x": 0,
                      "y": 0,
                      "width": "{{ (320 * (1 - (github.languages[0].share | default(0)) - (github.languages[1].share | default(0)) - (github.languages[2].share | default(0)) | max(0)) - 0 | max(0)) | max(0.001) }}",
                      "height": 5,
                      "fill": "{{ props.theme == \"dark\" ? \"#2A2F37\" : \"#DDE0E5\" }}",
                      "animate": {
                        "x": {
                          "keyframes": [
                            {
                              "offset": 0,
                              "value": 0
                            },
                            {
                              "offset": 0,
                              "value": "{{ 0 - (320 * (1 - (github.languages[0].share | default(0)) - (github.languages[1].share | default(0)) - (github.languages[2].share | default(0)) | max(0)) - 0 | max(0)) }}"
                            },
                            {
                              "offset": 0.4884,
                              "value": "{{ 0 - (320 * (1 - (github.languages[0].share | default(0)) - (github.languages[1].share | default(0)) - (github.languages[2].share | default(0)) | max(0)) - 0 | max(0)) }}",
                              "easing": {
                                "x1": 0.2,
                                "y1": 0.8,
                                "x2": 0.3,
                                "y2": 1
                              }
                            },
                            {
                              "offset": 1,
                              "value": 0
                            }
                          ],
                          "duration": 2150
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "rect",
                  "x": 0,
                  "y": 35,
                  "width": 840,
                  "height": 1,
                  "fill": "{{ props.theme == \"dark\" ? \"#2A2F37\" : \"#DDE0E5\" }}"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "layers": [
    {
      "type": "component",
      "ref": "card",
      "props": {
        "theme": "light"
      }
    }
  ]
}
